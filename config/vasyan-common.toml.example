# Vasyan Mod - configuration example
# All providers speak the OpenAI-compatible Chat Completions API.

[llm]
# LLM providers in priority order (failover chain). Every id must be a preset:
#   openai | groq | gemini | deepseek | openrouter | neuraldeep | ollama |
#   lmstudio | opencode-go | routerai | cloud-ru-fm | selectel-router | tokenra | custom
#
# If a request to the active provider fails, the next one is tried within the
# SAME request. When the head recovers, traffic fails back after
# failoverRetrySeconds. One entry = single provider, no failover.
#
# Keys/models/baseUrls are set per member in [llm.members.<id>] sections below.
providerChain = ["opencode-go", "ollama"]

# Seconds before the chain retries the highest-priority provider after a failover.
failoverRetrySeconds = 60

# Send response_format: {"type":"json_object"} for reliable JSON output.
# Disable if your provider rejects this field.
jsonMode = true

# Maximum tokens per API request
maxTokens = 8000

# Temperature (0.0-2.0, lower = more deterministic)
temperature = 0.7

# Per-request timeout in seconds
timeoutSeconds = 60

# Per-provider settings for chain members. Each section only needs the fields
# that differ from the preset default: unset/empty fields fall back to the
# preset (baseUrl/defaultModel). apiKey has NO preset - set it here for
# key-requiring providers.
#
# Preset base URLs:
#   openai           -> https://api.openai.com/v1
#   groq             -> https://api.groq.com/openai/v1
#   gemini           -> https://generativelanguage.googleapis.com/v1beta/openai
#   deepseek         -> https://api.deepseek.com
#   openrouter       -> https://openrouter.ai/api/v1
#   neuraldeep       -> https://api.neuraldeep.ru/v1
#   ollama           -> http://127.0.0.1:11434/v1 (no key)
#   lmstudio         -> http://127.0.0.1:1234/v1 (no key)
#   opencode-go      -> https://opencode.ai/zen/go/v1
#   routerai         -> https://routerai.ru/api/v1
#   cloud-ru-fm      -> https://foundation-models.api.cloud.ru/v1
#   selectel-router  -> https://api.selectel.ru/aig/v1
#   tokenra          -> https://tokenra.io/v1/
#   custom           -> any OpenAI-compatible endpoint; baseUrl REQUIRED here

[llm.members.opencode-go]
apiKey = "your-opencode-zen-key"
model = "deepseek-v4-flash"

[llm.members.tokenra]
apiKey = "sk-..."
model = "ox-alpha-1"

#[llm.members.custom]
#baseUrl = "https://your-endpoint.example.com/v1"
#apiKey = "key-if-needed"
#model = "some-model"

# Examples:
#
# OpenCode Go subscription (models: deepseek-v4-flash, deepseek-v4-pro, kimi-k3, glm-5.2, ...):
#   providerChain = ["opencode-go"]
#   [llm.members.opencode-go]
#   apiKey = "your-zen-key"
#
# Local ollama fallback:
#   providerChain = ["opencode-go", "ollama"]   # + members section above
#
# LAN ollama override:
#   [llm.members.ollama]
#   baseUrl = "http://192.168.1.50:11434/v1"
